---
import { hero } from '../data/content';
import CtaButton from './CtaButton.astro';
---

<section class="bg-[linear-gradient(352deg,#faaf19,#2d0356)]">
  <div
    class="mx-auto flex max-w-[75rem] flex-col items-center px-4 pt-9 md:min-h-[46.125rem] md:flex-row-reverse md:items-stretch md:justify-between md:px-0 md:pt-0"
  >
    <div class="text-center md:w-[38.625rem] md:pt-[7.5rem] md:pr-4 md:text-left">
      <h1 class="font-heading text-[2rem] leading-[1.3] font-bold text-svetla md:text-[3.75rem]">
        {hero.nadpis}
      </h1>
      <p class="mx-auto mt-6 max-w-[33rem] text-[1.0625rem] leading-[1.3] text-svetla md:mx-0 md:mt-8 md:text-2xl">
        {hero.podnadpis}
      </p>
      <div class="mt-12 md:mt-10">
        <CtaButton href="#konzultacia">{hero.cta}</CtaButton>
      </div>
    </div>
    <div class="mt-9 flex items-end md:mt-0 md:w-[37.4375rem]">
      <img
        src={hero.obrazok.src}
        srcset={`${hero.obrazok.srcMobil} 320w, ${hero.obrazok.src} 599w`}
        sizes="(max-width: 763px) 320px, 599px"
        alt={hero.obrazok.alt}
        width={hero.obrazok.width}
        height={hero.obrazok.height}
        class="mx-auto h-auto w-[20rem] md:w-full"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

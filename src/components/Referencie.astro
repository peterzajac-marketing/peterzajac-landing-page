---
import { referencie } from '../data/content';
---

<section class="bg-sky">
  <div class="mx-auto max-w-[75rem] px-4 py-16">
    <h2 class="text-center font-accent text-[2rem] leading-none font-bold text-orange md:text-[3.125rem]">
      {referencie.nadpis}
    </h2>
    <p class="mt-4 text-center font-accent text-base leading-[1.4]">{referencie.podnadpis}</p>
    <div class="mt-12 grid gap-6 md:grid-cols-2 md:gap-x-10 md:gap-y-11">
      {
        referencie.polozky.map((polozka) => (
          <div class="rounded-[20px] border-2 border-orange px-6 py-6 text-center md:text-left">
            <h3 class="font-heading text-xl font-bold text-navy">{polozka.meno}</h3>
            <p class="mt-3 text-[0.9375rem] leading-[1.3] text-navy md:text-base">{polozka.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

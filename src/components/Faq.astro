---
import { faq } from '../data/content';
import { withBase } from '../utils/withBase';
---

<section class="bg-[linear-gradient(190deg,#faaf19,#2d0356)]">
  <div class="mx-auto max-w-[75rem] px-4 py-12 md:py-14">
    <h2 class="text-center font-heading text-[2rem] leading-[1.3] font-bold text-svetla md:text-[3.5rem]">
      {faq.nadpis}
    </h2>
    <div class="mx-auto mt-9 max-w-[62.6875rem] space-y-2.5">
      {
        faq.polozky.map((polozka) => (
          <details class="group rounded-[10px] bg-white p-[15px]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2.5 font-heading text-xl font-bold text-ink [&::-webkit-details-marker]:hidden">
              {polozka.otazka}
              <img
                src={withBase('/images/icon_02e24789.svg')}
                alt=""
                width="20"
                height="20"
                class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180"
                loading="lazy"
              />
            </summary>
            <p class="pt-5 text-base leading-[1.4] text-ink">{polozka.odpoved}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Plynulé rozbaľovanie <details> — v prehliadačoch bez podpory
     ::details-content sa karta otvorí okamžite ako doteraz. */
  details::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      content-visibility 0.35s allow-discrete,
      block-size 0.35s ease;
  }

  details[open]::details-content {
    block-size: auto;
  }
</style>

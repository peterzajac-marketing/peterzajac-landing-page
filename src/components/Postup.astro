---
import { postup } from '../data/content';
import CtaButton from './CtaButton.astro';
import { withBase } from '../utils/withBase';
---

<section class="bg-svetla">
  <div class="mx-auto max-w-[75rem] px-4 py-16">
    <h2 class="text-center font-heading text-[2rem] leading-[1.3] font-bold text-ink md:text-[2.5rem]">
      {postup.nadpis}
    </h2>
    <div class="mt-12 flex flex-col gap-6 md:mt-14 md:flex-row md:items-stretch md:gap-4">
      {
        postup.kroky.map((krok, i) => (
          <>
            {i > 0 && (
              <img
                src={withBase('/images/icon_8107f96a.svg')}
                alt=""
                width="45"
                height="24"
                class="hidden shrink-0 self-center md:block"
                loading="lazy"
              />
            )}
            <div class="flex flex-1 flex-col items-center justify-center rounded-[15px] bg-navy px-5 py-7 text-center text-white">
              <h3 class="font-heading text-[1.0625rem] font-bold">{krok.titulok}</h3>
              <p class="mt-3 max-w-[13rem] text-[0.9375rem] leading-[1.4]">{krok.text}</p>
            </div>
          </>
        ))
      }
    </div>
    <div class="mt-16 text-center md:mt-20">
      <CtaButton href="#konzultacia" variant="orange">{postup.cta}</CtaButton>
    </div>
  </div>
</section>

---
import { ziskate } from '../data/content';
---

<section class="bg-[linear-gradient(190deg,#faaf19,#2d0356)]">
  <div class="mx-auto max-w-[75rem] px-4 py-16 md:py-14">
    <h2 class="text-center font-heading text-[2rem] leading-[1.3] font-bold text-white md:text-[2.5rem]">
      {ziskate.nadpis}
    </h2>
    <div class="mt-12 flex flex-col items-center gap-10 md:mt-16 md:flex-row md:justify-center md:gap-20">
      <img
        src={ziskate.obrazok.src}
        alt={ziskate.obrazok.alt}
        width={ziskate.obrazok.width}
        height={ziskate.obrazok.height}
        class="w-[18rem] md:w-[24.5rem]"
        loading="lazy"
      />
      <ol class="w-full max-w-[19.5rem] space-y-6">
        {
          ziskate.polozky.map((polozka, i) => (
            <li class="flex items-center gap-4 rounded-[15px] bg-sky px-7 py-5">
              <span class="font-heading text-[2rem] font-bold text-purple">{i + 1}.</span>
              <span class="flex-1 text-center text-[1.375rem] leading-[1.3] text-purple">{polozka}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
